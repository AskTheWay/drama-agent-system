# 复制此文件为 .env 并填入真实 API Key
# cp .env.example .env
#
# 所有 Key 均可留空：系统各节点有内置兜底数据，零 Key 也能完整跑通
# （前端「执行步骤」中会标注每步是「真实 LLM」还是「兜底演示数据」）

# LLM API（OpenAI 兼容接口；模型名需与 BASE_URL 指向的服务匹配）
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro

# 阿里云百炼 Embedding API（用于 FAISS 向量化；失效时索引以随机向量降级构建且不持久化）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# LangSmith 可观测性（可选）
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=drama-agent
